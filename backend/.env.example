# ─── Server ────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── Database ───────────────────────────────────────────────────────────────
# Local dev:
DATABASE_URL=postgresql://postgres:123456@localhost:5432/project_mgmt
DIRECT_URL=postgresql://postgres:123456@localhost:5432/project_mgmt

# Supabase (replace with values from: Project Settings → Database → Connection string):
# DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ─── Auth ───────────────────────────────────────────────────────────────────
# REQUIRED in production — generate with: openssl rand -hex 32
JWT_SECRET=replace-with-random-secret-min-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ─── CORS ───────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Anthropic AI ───────────────────────────────────────────────────────────
# Never commit real keys. Rotate immediately if exposed.
ANTHROPIC_API_KEY=sk-ant-...

# ─── AWS (optional) ─────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# ─── SMTP (optional) ────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@yourcompany.com

# ─── Microsoft 365 (optional) ───────────────────────────────────────────────
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
BACKEND_URL=http://localhost:4000
