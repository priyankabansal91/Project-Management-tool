generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── ENUMS ───────────────────────────────────────────────

enum UserStatus {
  active
  inactive
  suspended
  pending_verification
}

enum OrgRole {
  org_admin
  division_admin
  vertical_head
  project_manager
  team_lead
  member
  executive
  viewer
}

enum OrgPlan {
  free
  starter
  professional
  enterprise
}

enum ProjectStatus {
  active
  archived
  completed
  on_hold
}

enum ProjectVisibility {
  private
  org_wide
  public
}

enum TaskPriority {
  critical
  high
  medium
  low
  none
}

enum NotificationType {
  task_assigned
  task_updated
  task_commented
  project_created
  project_updated
  member_added
  mention
  due_date_reminder
  workflow_changed
}

// ─── ORGANIZATIONS ──────────────────────────────────────

model Organization {
  id            String    @id @default(uuid())
  name          String
  slug          String    @unique
  domain        String?
  logoUrl       String?   @map("logo_url")
  plan          OrgPlan   @default(free)
  planExpiresAt DateTime? @map("plan_expires_at")
  maxMembers    Int       @default(5) @map("max_members")
  maxProjects   Int       @default(3) @map("max_projects")
  isActive      Boolean   @default(true) @map("is_active")
  settings      Json      @default("{}")
  metadata      Json      @default("{}")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  members         OrgMember[]
  projects        Project[]
  workflowConfigs WorkflowConfig[]
  customFields    CustomFieldDefinition[]
  tasks           Task[]
  comments        Comment[]
  activityLogs    ActivityLog[]
  notifications   Notification[]
  sprints         Sprint[]
  timeLogs        TimeLog[]
  invitations     Invitation[]
  aiLogs          AiLog[]
  divisions       Division[]
  verticals       Vertical[]
  customRoles     CustomRole[]
  externalUsers   ExternalUser[]
  exports         Export[]
  Approval        Approval[]

  @@map("organizations")
}

// ─── DIVISIONS ──────────────────────────────────────────

model Division {
  id           String    @id @default(uuid())
  orgId        String    @map("org_id")
  parentId     String?   @map("parent_id")
  name         String
  description  String?
  code         String
  icon         String?
  color        String?
  settings     Json      @default("{}")
  budget       Decimal?
  headCount    Int?      @map("head_count")
  managerId    String?   @map("manager_id")
  isActive     Boolean   @default(true) @map("is_active")
  displayOrder Int       @default(0) @map("display_order")
  createdBy    String    @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  organization Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent       Division?        @relation("DivisionHierarchy", fields: [parentId], references: [id])
  children     Division[]       @relation("DivisionHierarchy")
  manager      User?            @relation(fields: [managerId], references: [id])
  members      DivisionMember[]
  projects     Project[]
  verticals    Vertical[]

  @@unique([orgId, code])
  @@map("divisions")
}

model Vertical {
  id          String   @id @default(uuid())
  name        String
  description String?
  color       String   @default("#3B82F6")
  status      String   @default("active")
  orgId       String   @map("org_id")
  divisionId  String?  @map("division_id")
  headId      String?  @map("head_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  division    Division?    @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  head        User?        @relation("VerticalHead", fields: [headId], references: [id], onDelete: SetNull)

  @@map("verticals")
}

model DivisionMember {
  id         String   @id @default(uuid())
  divisionId String   @map("division_id")
  userId     String   @map("user_id")
  role       String
  addedBy    String?  @map("added_by")
  createdAt  DateTime @default(now()) @map("created_at")

  division Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([divisionId, userId])
  @@map("division_members")
}

// ─── USERS ──────────────────────────────────────────────

model User {
  id               String     @id @default(uuid())
  email            String     @unique
  emailVerifiedAt  DateTime?  @map("email_verified_at")
  passwordHash     String?    @map("password_hash")
  firstName        String     @map("first_name")
  lastName         String     @map("last_name")
  avatarUrl        String?    @map("avatar_url")
  timezone         String     @default("UTC")
  locale           String     @default("en")
  status           UserStatus @default(pending_verification)
  lastLoginAt      DateTime?  @map("last_login_at")
  failedLoginCount Int        @default(0) @map("failed_login_count")
  lockedUntil      DateTime?  @map("locked_until")
  preferences      Json       @default("{}")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  deletedAt        DateTime?  @map("deleted_at")

  orgMembers        OrgMember[]
  refreshTokens     RefreshToken[]
  projectMembers    ProjectMember[]
  assignedTasks     Task[]             @relation("TaskAssignee")
  reportedTasks     Task[]             @relation("TaskReporter")
  createdTasks      Task[]             @relation("TaskCreator")
  comments          Comment[]
  activityLogs      ActivityLog[]
  notifications     Notification[]
  timeLogs          TimeLog[]
  aiLogs            AiLog[]
  integrations      UserIntegration[]
  approvalRequests  Approval[]         @relation("ApprovalRequester")
  approvalRecords   ApprovalRecord[]
  divisionMembers   DivisionMember[]
  customRoleMembers CustomRoleMember[]
  managedDivisions  Division[]
  verticalHeadOf    Vertical[]         @relation("VerticalHead")

  @@map("users")
}

// ─── ORG MEMBERS ────────────────────────────────────────

model OrgMember {
  id        String   @id @default(uuid())
  orgId     String   @map("org_id")
  userId    String   @map("user_id")
  role      OrgRole  @default(member)
  isOwner   Boolean  @default(false) @map("is_owner")
  invitedBy String?  @map("invited_by")
  joinedAt  DateTime @default(now()) @map("joined_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@map("org_members")
}

// ─── REFRESH TOKENS ─────────────────────────────────────

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  orgId      String?   @map("org_id")
  deviceInfo Json?     @map("device_info")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ─── WORKFLOW CONFIGS ───────────────────────────────────

model WorkflowConfig {
  id          String   @id @default(uuid())
  orgId       String   @map("org_id")
  name        String
  description String?
  isDefault   Boolean  @default(false) @map("is_default")
  statuses    Json     @default("[]")
  transitions Json     @default("[]")
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  projects     Project[]

  @@map("workflow_configs")
}

// ─── CUSTOM ROLES & PERMISSIONS ────────────────────────

model CustomRole {
  id          String   @id @default(uuid())
  orgId       String   @map("org_id")
  name        String
  description String?
  color       String?
  permissions Json     @default("[]")
  isSystem    Boolean  @default(false) @map("is_system")
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members      CustomRoleMember[]

  @@unique([orgId, name])
  @@map("custom_roles")
}

model CustomRoleMember {
  id         String   @id @default(uuid())
  roleId     String   @map("role_id")
  userId     String   @map("user_id")
  scope      String   @default("org")
  scopeId    String?  @map("scope_id")
  assignedBy String   @map("assigned_by")
  createdAt  DateTime @default(now()) @map("created_at")

  role CustomRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roleId, userId, scope, scopeId])
  @@map("custom_role_members")
}

// ─── EXTERNAL USERS ────────────────────────────────────

model ExternalUser {
  id           String    @id @default(uuid())
  orgId        String    @map("org_id")
  email        String
  firstName    String    @map("first_name")
  lastName     String    @map("last_name")
  avatarUrl    String?   @map("avatar_url")
  accessLevel  String    @default("viewer")
  permissions  Json      @default("[]")
  expiresAt    DateTime? @map("expires_at")
  invitedBy    String    @map("invited_by")
  invitedAt    DateTime  @default(now()) @map("invited_at")
  acceptedAt   DateTime? @map("accepted_at")
  lastAccessAt DateTime? @map("last_access_at")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  guestAccess  GuestAccess[]

  @@unique([orgId, email])
  @@map("external_users")
}

model GuestAccess {
  id             String    @id @default(uuid())
  externalUserId String    @map("external_user_id")
  resourceType   String    @map("resource_type")
  resourceId     String    @map("resource_id")
  accessLevel    String
  grantedBy      String    @map("granted_by")
  grantedAt      DateTime  @default(now()) @map("granted_at")
  expiresAt      DateTime? @map("expires_at")

  externalUser ExternalUser @relation(fields: [externalUserId], references: [id], onDelete: Cascade)

  @@unique([externalUserId, resourceType, resourceId])
  @@map("guest_access")
}

model CustomFieldDefinition {
  id           String   @id @default(uuid())
  orgId        String   @map("org_id")
  name         String
  fieldKey     String   @map("field_key")
  fieldType    String   @map("field_type")
  options      Json     @default("{}")
  isRequired   Boolean  @default(false) @map("is_required")
  isArchived   Boolean  @default(false) @map("is_archived")
  appliesTo    String   @default("task") @map("applies_to")
  displayOrder Int      @default(0) @map("display_order")
  createdBy    String   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, fieldKey])
  @@map("custom_field_definitions")
}

// ─── PROJECTS ───────────────────────────────────────────

model Project {
  id               String            @id @default(uuid())
  orgId            String            @map("org_id")
  divisionId       String?           @map("division_id")
  name             String
  description      String?
  key              String
  status           ProjectStatus     @default(active)
  visibility       ProjectVisibility @default(private)
  color            String            @default("#3B82F6")
  icon             String?
  workflowConfigId String?           @map("workflow_config_id")
  ownerId          String            @map("owner_id")
  startDate        DateTime?         @map("start_date")
  dueDate          DateTime?         @map("due_date")
  customFields     Json              @default("{}") @map("custom_fields")
  settings         Json              @default("{}")
  createdBy        String            @map("created_by")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  deletedAt        DateTime?         @map("deleted_at")

  organization   Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  division       Division?       @relation(fields: [divisionId], references: [id])
  workflowConfig WorkflowConfig? @relation(fields: [workflowConfigId], references: [id])
  members        ProjectMember[]
  tasks          Task[]
  sprints        Sprint[]

  @@unique([orgId, key])
  @@map("projects")
}

// ─── PROJECT MEMBERS ────────────────────────────────────

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  role      OrgRole  @default(member)
  addedBy   String?  @map("added_by")
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

// ─── TASKS ──────────────────────────────────────────────

model Task {
  id                 String       @id @default(uuid())
  orgId              String       @map("org_id")
  projectId          String       @map("project_id")
  parentTaskId       String?      @map("parent_task_id")
  seqNumber          Int          @map("seq_number")
  title              String
  description        String?
  statusId           String?      @map("status_id")
  statusName         String?      @map("status_name")
  priority           TaskPriority @default(medium)
  type               String       @default("task")
  assigneeId         String?      @map("assignee_id")
  reporterId         String       @map("reporter_id")
  dueDate            DateTime?    @map("due_date")
  startDate          DateTime?    @map("start_date")
  estimatedHours     Decimal?     @map("estimated_hours")
  loggedHours        Decimal      @default(0) @map("logged_hours")
  position           Decimal      @default(0)
  tags               String[]     @default([])
  customFields       Json         @default("{}") @map("custom_fields")
  attachments        Json         @default("[]")
  formTemplateId     String?      @map("form_template_id")
  formSubmissionData Json?        @map("form_submission_data")
  sprintId           String?      @map("sprint_id")
  isArchived         Boolean      @default(false) @map("is_archived")
  completedAt        DateTime?    @map("completed_at")
  createdBy          String       @map("created_by")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  deletedAt          DateTime?    @map("deleted_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint       Sprint?      @relation(fields: [sprintId], references: [id])
  parentTask   Task?        @relation("Subtasks", fields: [parentTaskId], references: [id])
  subtasks     Task[]       @relation("Subtasks")
  assignee     User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  reporter     User         @relation("TaskReporter", fields: [reporterId], references: [id])
  creator      User         @relation("TaskCreator", fields: [createdBy], references: [id])
  comments     Comment[]
  timeLogs     TimeLog[]

  @@unique([projectId, seqNumber])
  @@map("tasks")
}

// ─── COMMENTS ───────────────────────────────────────────

model Comment {
  id          String    @id @default(uuid())
  orgId       String    @map("org_id")
  taskId      String    @map("task_id")
  parentId    String?   @map("parent_id")
  authorId    String    @map("author_id")
  body        String
  mentions    String[]  @default([])
  attachments Json      @default("[]")
  isEdited    Boolean   @default(false) @map("is_edited")
  editedAt    DateTime? @map("edited_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  parent       Comment?     @relation("CommentThread", fields: [parentId], references: [id])
  replies      Comment[]    @relation("CommentThread")
  author       User         @relation(fields: [authorId], references: [id])

  @@map("comments")
}

// ─── ACTIVITY LOGS ──────────────────────────────────────

model ActivityLog {
  id         String   @id @default(uuid())
  orgId      String   @map("org_id")
  actorId    String?  @map("actor_id")
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  action     String
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  diff       Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id])

  @@map("activity_logs")
}

// ─── NOTIFICATIONS ──────────────────────────────────────

model Notification {
  id         String           @id @default(uuid())
  orgId      String           @map("org_id")
  userId     String           @map("user_id")
  type       NotificationType
  title      String
  body       String?
  entityType String?          @map("entity_type")
  entityId   String?          @map("entity_id")
  actorId    String?          @map("actor_id")
  isRead     Boolean          @default(false) @map("is_read")
  readAt     DateTime?        @map("read_at")
  createdAt  DateTime         @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ─── SPRINTS ────────────────────────────────────────────

model Sprint {
  id        String    @id @default(uuid())
  orgId     String    @map("org_id")
  projectId String    @map("project_id")
  name      String
  goal      String?
  status    String    @default("planned")
  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")
  createdBy String    @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks        Task[]

  @@map("sprints")
}

// ─── TIME LOGS ──────────────────────────────────────────

model TimeLog {
  id          String   @id @default(uuid())
  orgId       String   @map("org_id")
  taskId      String   @map("task_id")
  userId      String   @map("user_id")
  hours       Decimal
  description String?
  loggedDate  DateTime @default(now()) @map("logged_date")
  createdAt   DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("time_logs")
}

// ─── INVITATIONS ────────────────────────────────────────

model Invitation {
  id         String    @id @default(uuid())
  orgId      String    @map("org_id")
  email      String
  role       OrgRole   @default(member)
  tokenHash  String    @unique @map("token_hash")
  invitedBy  String    @map("invited_by")
  acceptedAt DateTime? @map("accepted_at")
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("invitations")
}

// ─── AI LOGS ────────────────────────────────────────────

model AiLog {
  id               String   @id @default(uuid())
  orgId            String   @map("org_id")
  userId           String   @map("user_id")
  feature          String
  promptTokens     Int?     @map("prompt_tokens")
  completionTokens Int?     @map("completion_tokens")
  model            String?
  entityType       String?  @map("entity_type")
  entityId         String?  @map("entity_id")
  createdAt        DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@map("ai_logs")
}

// ─── POINT-IN-TIME HISTORY & VERSIONING ────────────────

model EntityVersion {
  id           String   @id @default(uuid())
  orgId        String   @map("org_id")
  entityType   String   @map("entity_type")
  entityId     String   @map("entity_id")
  version      Int
  data         Json
  changes      Json?
  changedBy    String   @map("changed_by")
  changeReason String?  @map("change_reason")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([entityId, entityType, version])
  @@map("entity_versions")
}

model Snapshot {
  id           String   @id @default(uuid())
  orgId        String   @map("org_id")
  name         String
  description  String?
  snapshotType String   @map("snapshot_type")
  data         Json
  createdBy    String   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("snapshots")
}

// ─── EXPORT FRAMEWORK ──────────────────────────────────

model Export {
  id           String    @id @default(uuid())
  orgId        String    @map("org_id")
  name         String
  description  String?
  exportType   String    @map("export_type")
  format       String
  filters      Json      @default("{}")
  columns      Json      @default("[]")
  status       String    @default("pending")
  fileUrl      String?   @map("file_url")
  fileSize     Int?      @map("file_size")
  recordCount  Int?      @map("record_count")
  errorMessage String?   @map("error_message")
  requestedBy  String    @map("requested_by")
  completedAt  DateTime? @map("completed_at")
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("exports")
}

model Approval {
  id               String   @id @default(uuid())
  orgId            String   @map("org_id")
  workflowId       String   @map("workflow_id")
  title            String
  description      String?
  content          String?
  status           String   @default("pending")
  currentStep      Int      @default(1) @map("current_step")
  requestedBy      String   @map("requested_by")
  relatedTaskId    String?  @map("related_task_id")
  relatedProjectId String?  @map("related_project_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization    Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  requestedByUser User             @relation("ApprovalRequester", fields: [requestedBy], references: [id])
  steps           ApprovalStep[]
  approvals       ApprovalRecord[]

  @@map("approvals")
}

model ApprovalStep {
  id         String   @id @default(uuid())
  approvalId String   @map("approval_id")
  stepId     String   @map("step_id")
  stepName   String   @map("step_name")
  stepOrder  Int      @map("step_order")
  role       String
  status     String   @default("pending")
  parallel   Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  approval Approval @relation(fields: [approvalId], references: [id], onDelete: Cascade)

  @@map("approval_steps")
}

model ApprovalRecord {
  id         String   @id @default(uuid())
  approvalId String   @map("approval_id")
  stepId     String   @map("step_id")
  approvedBy String   @map("approved_by")
  action     String
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at")

  approval Approval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  approver User     @relation(fields: [approvedBy], references: [id])

  @@map("approval_records")
}

// ─── USER INTEGRATIONS (OAuth tokens for external services) ──

model UserIntegration {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  provider        String
  providerUserId  String?   @map("provider_user_id")
  providerEmail   String?   @map("provider_email")
  tokenData       Json      @map("token_data")
  settings        Json      @default("{}")
  calendarMapping Json      @default("{}") @map("calendar_mapping")
  connectedAt     DateTime  @default(now()) @map("connected_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("user_integrations")
}

// ─── EMAIL OTP ────────────────────────────────────────────

model EmailOtp {
  id        String    @id @default(uuid())
  email     String
  codeHash  String    @map("code_hash")
  purpose   String    // verify_email | change_email | password_reset
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([email, purpose])
  @@map("email_otps")
}
