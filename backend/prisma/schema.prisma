generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────

enum UserStatus {
  active
  inactive
  suspended
  pending_verification
}

enum OrgRole {
  org_admin
  project_manager
  member
  viewer
}

enum OrgPlan {
  free
  starter
  professional
  enterprise
}

enum ProjectStatus {
  active
  archived
  completed
  on_hold
}

enum ProjectVisibility {
  private
  org_wide
  public
}

enum TaskPriority {
  critical
  high
  medium
  low
  none
}

enum NotificationType {
  task_assigned
  task_updated
  task_commented
  project_created
  project_updated
  member_added
  mention
  due_date_reminder
  workflow_changed
}

// ─── ORGANIZATIONS ──────────────────────────────────────

model Organization {
  id            String    @id @default(uuid()) @db.Uuid
  name          String    @db.VarChar(255)
  slug          String    @unique @db.VarChar(100)
  domain        String?   @db.VarChar(255)
  logoUrl       String?   @map("logo_url") @db.VarChar(500)
  plan          OrgPlan   @default(free)
  planExpiresAt DateTime? @map("plan_expires_at") @db.Timestamptz()
  maxMembers    Int       @default(5) @map("max_members")
  maxProjects   Int       @default(3) @map("max_projects")
  isActive      Boolean   @default(true) @map("is_active")
  settings      Json      @default("{}")
  metadata      Json      @default("{}")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz()

  members         OrgMember[]
  projects        Project[]
  workflowConfigs WorkflowConfig[]
  customFields    CustomFieldDefinition[]
  tasks           Task[]
  comments        Comment[]
  activityLogs    ActivityLog[]
  notifications   Notification[]
  sprints         Sprint[]
  timeLogs        TimeLog[]
  invitations     Invitation[]
  aiLogs          AiLog[]
  divisions       Division[]
  customRoles     CustomRole[]
  externalUsers   ExternalUser[]
  exports         Export[]

  @@map("organizations")
}

// ─── DIVISIONS ──────────────────────────────────────────

model Division {
  id            String   @id @default(uuid()) @db.Uuid
  orgId         String   @map("org_id") @db.Uuid
  parentId      String?  @map("parent_id") @db.Uuid
  name          String   @db.VarChar(255)
  description   String?  @db.Text
  code          String   @db.VarChar(50)
  icon          String?  @db.VarChar(50)
  color         String?  @db.VarChar(7)
  settings      Json     @default("{}")
  budget        Decimal? @db.Decimal(15, 2)
  headCount     Int?     @map("head_count")
  managerId     String?  @map("manager_id") @db.Uuid
  isActive      Boolean  @default(true) @map("is_active")
  displayOrder  Int      @default(0) @map("display_order")
  createdBy     String   @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent       Division?     @relation("DivisionHierarchy", fields: [parentId], references: [id])
  children     Division[]    @relation("DivisionHierarchy")
  manager      User?         @relation(fields: [managerId], references: [id])
  members      DivisionMember[]
  projects     Project[]

  @@unique([orgId, code])
  @@map("divisions")
}

model DivisionMember {
  id        String   @id @default(uuid()) @db.Uuid
  divisionId String  @map("division_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String   @db.VarChar(100)
  addedBy   String?  @map("added_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  division Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([divisionId, userId])
  @@map("division_members")
}

// ─── USERS ──────────────────────────────────────────────

model User {
  id               String     @id @default(uuid()) @db.Uuid
  email            String     @unique @db.VarChar(320)
  emailVerifiedAt  DateTime?  @map("email_verified_at") @db.Timestamptz()
  passwordHash     String?    @map("password_hash") @db.VarChar(255)
  firstName        String     @map("first_name") @db.VarChar(100)
  lastName         String     @map("last_name") @db.VarChar(100)
  avatarUrl        String?    @map("avatar_url") @db.VarChar(500)
  timezone         String     @default("UTC") @db.VarChar(64)
  locale           String     @default("en") @db.VarChar(10)
  status           UserStatus @default(pending_verification)
  lastLoginAt      DateTime?  @map("last_login_at") @db.Timestamptz()
  failedLoginCount Int        @default(0) @map("failed_login_count") @db.SmallInt
  lockedUntil      DateTime?  @map("locked_until") @db.Timestamptz()
  preferences      Json       @default("{}")
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt        DateTime?  @map("deleted_at") @db.Timestamptz()

  orgMembers      OrgMember[]
  refreshTokens   RefreshToken[]
  projectMembers  ProjectMember[]
  assignedTasks   Task[]          @relation("TaskAssignee")
  reportedTasks   Task[]          @relation("TaskReporter")
  createdTasks    Task[]          @relation("TaskCreator")
  comments        Comment[]
  activityLogs    ActivityLog[]
  notifications   Notification[]
  timeLogs        TimeLog[]
  aiLogs          AiLog[]
  integrations    UserIntegration[]
  approvalRequests Approval[]      @relation("ApprovalRequester")
  approvalRecords ApprovalRecord[]
  divisionMembers DivisionMember[]
  customRoleMembers CustomRoleMember[]
  managedDivisions Division[]

  @@map("users")
}

// ─── ORG MEMBERS ────────────────────────────────────────

model OrgMember {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      OrgRole  @default(member)
  isOwner   Boolean  @default(false) @map("is_owner")
  invitedBy String?  @map("invited_by") @db.Uuid
  joinedAt  DateTime @default(now()) @map("joined_at") @db.Timestamptz()
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@map("org_members")
}

// ─── REFRESH TOKENS ─────────────────────────────────────

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  orgId      String?   @map("org_id") @db.Uuid
  deviceInfo Json?     @map("device_info")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz()
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz()
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ─── WORKFLOW CONFIGS ───────────────────────────────────

model WorkflowConfig {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  name        String   @db.VarChar(100)
  description String?  @db.Text
  isDefault   Boolean  @default(false) @map("is_default")
  statuses    Json     @default("[]")
  transitions Json     @default("[]")
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  projects     Project[]

  @@map("workflow_configs")
}

// ─── CUSTOM ROLES & PERMISSIONS ────────────────────────

model CustomRole {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  name        String   @db.VarChar(100)
  description String?  @db.Text
  color       String?  @db.VarChar(7)
  permissions Json     @default("[]")
  isSystem    Boolean  @default(false) @map("is_system")
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members      CustomRoleMember[]

  @@unique([orgId, name])
  @@map("custom_roles")
}

model CustomRoleMember {
  id         String   @id @default(uuid()) @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  scope      String   @default("org") @db.VarChar(50)
  scopeId    String?  @map("scope_id") @db.Uuid
  assignedBy String   @map("assigned_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  role CustomRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roleId, userId, scope, scopeId])
  @@map("custom_role_members")
}

// ─── EXTERNAL USERS ────────────────────────────────────

model ExternalUser {
  id            String    @id @default(uuid()) @db.Uuid
  orgId         String    @map("org_id") @db.Uuid
  email         String    @db.VarChar(320)
  firstName     String    @map("first_name") @db.VarChar(100)
  lastName      String    @map("last_name") @db.VarChar(100)
  avatarUrl     String?   @map("avatar_url") @db.VarChar(500)
  accessLevel   String    @default("viewer") @db.VarChar(50)
  permissions   Json      @default("[]")
  expiresAt     DateTime? @map("expires_at") @db.Timestamptz()
  invitedBy     String    @map("invited_by") @db.Uuid
  invitedAt     DateTime  @default(now()) @map("invited_at") @db.Timestamptz()
  acceptedAt    DateTime? @map("accepted_at") @db.Timestamptz()
  lastAccessAt  DateTime? @map("last_access_at") @db.Timestamptz()
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  guestAccess  GuestAccess[]

  @@unique([orgId, email])
  @@map("external_users")
}

model GuestAccess {
  id             String   @id @default(uuid()) @db.Uuid
  externalUserId String   @map("external_user_id") @db.Uuid
  resourceType   String   @map("resource_type") @db.VarChar(50)
  resourceId     String   @map("resource_id") @db.Uuid
  accessLevel    String   @db.VarChar(50)
  grantedBy      String   @map("granted_by") @db.Uuid
  grantedAt      DateTime @default(now()) @map("granted_at") @db.Timestamptz()
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz()

  externalUser ExternalUser @relation(fields: [externalUserId], references: [id], onDelete: Cascade)

  @@unique([externalUserId, resourceType, resourceId])
  @@map("guest_access")
}
  id           String   @id @default(uuid()) @db.Uuid
  orgId        String   @map("org_id") @db.Uuid
  name         String   @db.VarChar(100)
  fieldKey     String   @map("field_key") @db.VarChar(100)
  fieldType    String   @map("field_type") @db.VarChar(50)
  options      Json     @default("{}")
  isRequired   Boolean  @default(false) @map("is_required")
  isArchived   Boolean  @default(false) @map("is_archived")
  appliesTo    String   @default("task") @map("applies_to") @db.VarChar(50)
  displayOrder Int      @default(0) @map("display_order") @db.SmallInt
  createdBy    String   @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, fieldKey])
  @@map("custom_field_definitions")
}

// ─── PROJECTS ───────────────────────────────────────────

model Project {
  id               String            @id @default(uuid()) @db.Uuid
  orgId            String            @map("org_id") @db.Uuid
  divisionId       String?           @map("division_id") @db.Uuid
  name             String            @db.VarChar(255)
  description      String?           @db.Text
  key              String            @db.VarChar(10)
  status           ProjectStatus     @default(active)
  visibility       ProjectVisibility @default(private)
  color            String            @default("#3B82F6") @db.VarChar(7)
  icon             String?           @db.VarChar(50)
  workflowConfigId String?           @map("workflow_config_id") @db.Uuid
  ownerId          String            @map("owner_id") @db.Uuid
  startDate        DateTime?         @map("start_date") @db.Date
  dueDate          DateTime?         @map("due_date") @db.Date
  customFields     Json              @default("{}") @map("custom_fields")
  settings         Json              @default("{}")
  createdBy        String            @map("created_by") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt        DateTime?         @map("deleted_at") @db.Timestamptz()

  organization   Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  division       Division?       @relation(fields: [divisionId], references: [id])
  workflowConfig WorkflowConfig? @relation(fields: [workflowConfigId], references: [id])
  members        ProjectMember[]
  tasks          Task[]
  sprints        Sprint[]

  @@unique([orgId, key])
  @@map("projects")
}

// ─── PROJECT MEMBERS ────────────────────────────────────

model ProjectMember {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      OrgRole  @default(member)
  addedBy   String?  @map("added_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

// ─── TASKS ──────────────────────────────────────────────

model Task {
  id             String       @id @default(uuid()) @db.Uuid
  orgId          String       @map("org_id") @db.Uuid
  projectId      String       @map("project_id") @db.Uuid
  parentTaskId   String?      @map("parent_task_id") @db.Uuid
  seqNumber      Int          @map("seq_number")
  title          String       @db.VarChar(500)
  description    String?      @db.Text
  statusId       String?      @map("status_id")
  statusName     String?      @map("status_name") @db.VarChar(100)
  priority       TaskPriority @default(medium)
  type           String       @default("task") @db.VarChar(50)
  assigneeId     String?      @map("assignee_id") @db.Uuid
  reporterId     String       @map("reporter_id") @db.Uuid
  dueDate        DateTime?    @map("due_date") @db.Date
  startDate      DateTime?    @map("start_date") @db.Date
  estimatedHours Decimal?     @map("estimated_hours") @db.Decimal(8, 2)
  loggedHours    Decimal      @default(0) @map("logged_hours") @db.Decimal(8, 2)
  position       Decimal      @default(0) @db.Decimal(10, 5)
  tags           String[]     @default([])
  customFields   Json         @default("{}") @map("custom_fields")
  attachments    Json         @default("[]")
  formTemplateId String?      @map("form_template_id") @db.VarChar(100)
  formSubmissionData Json?    @map("form_submission_data")
  isArchived     Boolean      @default(false) @map("is_archived")
  completedAt    DateTime?    @map("completed_at") @db.Timestamptz()
  createdBy      String       @map("created_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt      DateTime?    @map("deleted_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentTask   Task?        @relation("Subtasks", fields: [parentTaskId], references: [id])
  subtasks     Task[]       @relation("Subtasks")
  assignee     User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  reporter     User         @relation("TaskReporter", fields: [reporterId], references: [id])
  creator      User         @relation("TaskCreator", fields: [createdBy], references: [id])
  comments     Comment[]
  timeLogs     TimeLog[]

  @@unique([projectId, seqNumber])
  @@map("tasks")
}

// ─── COMMENTS ───────────────────────────────────────────

model Comment {
  id          String    @id @default(uuid()) @db.Uuid
  orgId       String    @map("org_id") @db.Uuid
  taskId      String    @map("task_id") @db.Uuid
  parentId    String?   @map("parent_id") @db.Uuid
  authorId    String    @map("author_id") @db.Uuid
  body        String    @db.Text
  mentions    String[]  @default([]) @db.Uuid
  attachments Json      @default("[]")
  isEdited    Boolean   @default(false) @map("is_edited")
  editedAt    DateTime? @map("edited_at") @db.Timestamptz()
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  parent       Comment?     @relation("CommentThread", fields: [parentId], references: [id])
  replies      Comment[]    @relation("CommentThread")
  author       User         @relation(fields: [authorId], references: [id])

  @@map("comments")
}

// ─── ACTIVITY LOGS ──────────────────────────────────────

model ActivityLog {
  id         String   @id @default(uuid()) @db.Uuid
  orgId      String   @map("org_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String   @map("entity_id") @db.Uuid
  action     String   @db.VarChar(100)
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  diff       Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent") @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id])

  @@map("activity_logs")
}

// ─── NOTIFICATIONS ──────────────────────────────────────

model Notification {
  id         String           @id @default(uuid()) @db.Uuid
  orgId      String           @map("org_id") @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  type       NotificationType
  title      String           @db.VarChar(255)
  body       String?          @db.Text
  entityType String?          @map("entity_type") @db.VarChar(50)
  entityId   String?          @map("entity_id") @db.Uuid
  actorId    String?          @map("actor_id") @db.Uuid
  isRead     Boolean          @default(false) @map("is_read")
  readAt     DateTime?        @map("read_at") @db.Timestamptz()
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ─── SPRINTS ────────────────────────────────────────────

model Sprint {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  name      String   @db.VarChar(255)
  goal      String?  @db.Text
  status    String   @default("planned") @db.VarChar(20)
  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("sprints")
}

// ─── TIME LOGS ──────────────────────────────────────────

model TimeLog {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  taskId      String   @map("task_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  hours       Decimal  @db.Decimal(8, 2)
  description String?  @db.Text
  loggedDate  DateTime @default(now()) @map("logged_date") @db.Date
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("time_logs")
}

// ─── INVITATIONS ────────────────────────────────────────

model Invitation {
  id         String    @id @default(uuid()) @db.Uuid
  orgId      String    @map("org_id") @db.Uuid
  email      String    @db.VarChar(320)
  role       OrgRole   @default(member)
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  invitedBy  String    @map("invited_by") @db.Uuid
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz()
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz()
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("invitations")
}

// ─── AI LOGS ────────────────────────────────────────────

model AiLog {
  id               String   @id @default(uuid()) @db.Uuid
  orgId            String   @map("org_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  feature          String   @db.VarChar(100)
  promptTokens     Int?     @map("prompt_tokens")
  completionTokens Int?     @map("completion_tokens")
  model            String?  @db.VarChar(100)
  entityType       String?  @map("entity_type") @db.VarChar(50)
  entityId         String?  @map("entity_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@map("ai_logs")
}

// ─── POINT-IN-TIME HISTORY & VERSIONING ────────────────

model EntityVersion {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  entityType  String   @map("entity_type") @db.VarChar(50)
  entityId    String   @map("entity_id") @db.Uuid
  version     Int
  data        Json
  changes     Json?
  changedBy   String   @map("changed_by") @db.Uuid
  changeReason String? @map("change_reason") @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@unique([entityId, entityType, version])
  @@map("entity_versions")
}

model Snapshot {
  id          String   @id @default(uuid()) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  name        String   @db.VarChar(255)
  description String? @db.Text
  snapshotType String @map("snapshot_type") @db.VarChar(50)
  data        Json
  createdBy   String  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@map("snapshots")
}

// ─── EXPORT FRAMEWORK ──────────────────────────────────

model Export {
  id            String    @id @default(uuid()) @db.Uuid
  orgId         String    @map("org_id") @db.Uuid
  name          String    @db.VarChar(255)
  description   String?   @db.Text
  exportType    String    @map("export_type") @db.VarChar(50)
  format        String    @db.VarChar(20)
  filters       Json      @default("{}")
  columns       Json      @default("[]")
  status        String    @default("pending") @db.VarChar(50)
  fileUrl       String?   @map("file_url") @db.VarChar(500)
  fileSize      Int?      @map("file_size")
  recordCount   Int?      @map("record_count")
  errorMessage  String?   @map("error_message") @db.Text
  requestedBy   String    @map("requested_by") @db.Uuid
  completedAt   DateTime? @map("completed_at") @db.Timestamptz()
  expiresAt     DateTime? @map("expires_at") @db.Timestamptz()
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("exports")
}

model Approval {
  id               String   @id @default(uuid()) @db.Uuid
  orgId            String   @map("org_id") @db.Uuid
  workflowId       String   @map("workflow_id") @db.VarChar(100)
  title            String   @db.VarChar(255)
  description      String?  @db.Text
  content          String?  @db.Text
  status           String   @default("pending") @db.VarChar(50)
  currentStep      Int      @default(1) @map("current_step")
  requestedBy      String   @map("requested_by") @db.Uuid
  relatedTaskId    String?  @map("related_task_id") @db.Uuid
  relatedProjectId String?  @map("related_project_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  requestedByUser  User         @relation("ApprovalRequester", fields: [requestedBy], references: [id])
  steps            ApprovalStep[]
  approvals        ApprovalRecord[]

  @@map("approvals")
}

model ApprovalStep {
  id        String   @id @default(uuid()) @db.Uuid
  approvalId String  @map("approval_id") @db.Uuid
  stepId    String   @map("step_id") @db.VarChar(100)
  stepName  String   @map("step_name") @db.VarChar(255)
  stepOrder Int      @map("step_order")
  role      String   @db.VarChar(100)
  status    String   @default("pending") @db.VarChar(50)
  parallel  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  approval Approval @relation(fields: [approvalId], references: [id], onDelete: Cascade)

  @@map("approval_steps")
}

model ApprovalRecord {
  id         String   @id @default(uuid()) @db.Uuid
  approvalId String   @map("approval_id") @db.Uuid
  stepId     String   @map("step_id") @db.Uuid
  approvedBy String   @map("approved_by") @db.Uuid
  action     String   @db.VarChar(50)
  reason     String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  approval Approval @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  approver User     @relation(fields: [approvedBy], references: [id])

  @@map("approval_records")
}

// ─── USER INTEGRATIONS (OAuth tokens for external services) ──

model UserIntegration {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  provider        String    @db.VarChar(50)              // microsoft, google, slack
  providerUserId  String?   @map("provider_user_id") @db.VarChar(255)
  providerEmail   String?   @map("provider_email") @db.VarChar(320)
  tokenData       Json      @map("token_data")           // { access_token, refresh_token, expires_at }
  settings        Json      @default("{}")                // { sync_calendar, email_notifications, ... }
  calendarMapping Json      @default("{}") @map("calendar_mapping") // { taskId: outlookEventId, ... }
  connectedAt     DateTime  @default(now()) @map("connected_at") @db.Timestamptz()
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz()
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@map("user_integrations")
}
